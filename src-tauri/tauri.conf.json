{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenCaptureTool",
  "version": "0.3.3",
  "identifier": "com.screencapture.tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 660,
        "height": 520,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwOTA1NDE0NjAyMDQzMjQKUldRa1F5QmdGRlNRb09kMnlwaldtTHhPUDluZkhQV0Mrckt3K0VTWW5RdmJTNGxtOWxINGdXcEEK",
      "endpoints": [
        "https://github.com/milletlovemouse/screen-capture-tool/releases/latest/download/latest.json"
      ]
    }
  }
}
